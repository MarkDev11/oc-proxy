# Local server
PORT=8791
HOST=127.0.0.1

# Required for the public tunnel endpoint. Comma-separated keys are supported.
GATEWAY_API_KEY=

# Cloudflare Quick Tunnel (optional; set TUNNEL_DISABLED=1 to skip)
CLOUDFLARED_BIN=bin/cloudflared
# Use http2 if QUIC/UDP is blocked on your network.
# TUNNEL_PROTOCOL=http2
# TUNNEL_URL_FILE=run/tunnel-url.txt

# Skip the built-in Cloudflare tunnel (e.g. when using Tailscale Funnel).
# TUNNEL_DISABLED=0
# External public URL published by /api/tunnel and the dashboard. When this is
# a *.ts.net host and TUNNEL_DISABLED=1, scripts/start.sh also brings up
# tailscaled and `tailscale funnel --bg` (see scripts/tailscale.sh).
# PUBLIC_URL=https://oc-proxy.tail81c43d.ts.net

# Optional graceful cutoffs (milliseconds, 0 = disabled).
# SOFT runs from the first upstream bytes; ABSOLUTE counts from request start.
# SOFT_DEADLINE_MS=0
# ABSOLUTE_DEADLINE_MS=0

# Request/response body logging. Off by default because request bodies may
# contain third-party secrets in tool results. Enable only for debugging.
# REQUEST_LOG_ENABLED=1

# Optional overrides
# UPSTREAM_BASE_URL=https://opencode.ai
# ANTHROPIC_DEFAULT_MODEL=mimo-v2.6-flash-free

# OpenCode Console key. The proxy prefers OPENCODE_CONSOLE_KEY, then
# OPENCODE_KEY_FILE, then the literal "public" token.
# OPENCODE_CONSOLE_KEY=oc_sk_...
# OPENCODE_KEY_FILE=run/opencode-console.key

# WARP egress. Default is wireproxy (userspace WireGuard) at 127.0.0.1:28091.
# WARP_ENGINE=wireproxy
# WARP_WIREPROXY_PORT=28091
# WARP_WIREPROXY_INFO_PORT=28092
# WARP_MAX_ATTEMPTS=5
# WARP_ROTATE=1
# A rotation is accepted only when every model here returns 200; keep the
# models that are hardest to get on a fresh WARP address.
# WARP_VERIFY_MODELS=deepseek-v4.1-flash-free,mimo-v2.6-flash-free,tidepool-alpha-free
# On FreeUsageLimitError the request is held while WARP is rotated, exactly
# like opencode-hop: no cooldown, concurrent 429s share one rotation, and the
# request is retried as soon as a fresh egress verifies.
# WARP_QUOTA_ROTATE_ROUNDS=6
# How long one rotation run may take before the next round starts.
# WARP_AUTO_ROTATE_TIMEOUT_MS=180000
# Route upstream through WARP and lock the dashboard toggle on.
# UPSTREAM_PROXY=http://127.0.0.1:28091

# Legacy usque MASQUE engine (WARP_ENGINE=usque).
# WARP_COOLDOWN=600
# WARP_FAIL_BACKOFF=300
# WARP_POLL=5
# WARP_PROXY_PORT=28090
# WARP_FWD_PORT=24443
# WARP_ENDPOINT=162.159.198.3
# USQUE_DIR=/workspace/usque
# USQUE_BIN=/workspace/usque/usque-h2-v6
# WARP_CONFIG=/workspace/usque/config2.json

# Upstream retry (FreeUsageLimitError is common on the free tier)
# UPSTREAM_MAX_WAIT_MS=120000
# UPSTREAM_RETRY_DELAY_MS=2000
# Per-attempt connect timeout; a timeout is not retried.
# UPSTREAM_CONNECT_TIMEOUT_MS=20000
# Override the spoofed OpenCode user agent
# OPENCODE_UA=opencode/1.19.5 ai-sdk/provider-utils/4.0.23 runtime/bun/1.4.4
# Bun is required for the OpenCode TLS fingerprint (npm i -g bun)
# BUN_BIN=bun
