# Local server
PORT=8791
HOST=127.0.0.1

# Required for the public tunnel endpoint. Comma-separated keys are supported.
GATEWAY_API_KEY=

# Cloudflare Quick Tunnel
CLOUDFLARED_BIN=bin/cloudflared
# Use http2 if QUIC/UDP is blocked on your network.
# TUNNEL_PROTOCOL=http2
# TUNNEL_URL_FILE=run/tunnel-url.txt

# Optional graceful cutoffs (milliseconds, 0 = disabled).
# SOFT runs from the first upstream bytes; ABSOLUTE counts from request start.
# SOFT_DEADLINE_MS=0
# ABSOLUTE_DEADLINE_MS=0

# Optional overrides
# UPSTREAM_BASE_URL=https://opencode.ai
# ANTHROPIC_DEFAULT_MODEL=mimo-v2.6-flash-free

# Upstream retry (FreeUsageLimitError is common on the free tier)
# UPSTREAM_MAX_WAIT_MS=120000
# UPSTREAM_RETRY_DELAY_MS=2000
# Override the spoofed OpenCode user agent
# OPENCODE_UA=opencode/1.19.5 ai-sdk/provider-utils/4.0.23 runtime/bun/1.4.4
# Bun is required for the OpenCode TLS fingerprint (npm i -g bun)
# BUN_BIN=bun
