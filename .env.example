GATEWAY_API_KEY=
# Optional override, default https://opencode.ai
# UPSTREAM_BASE_URL=https://opencode.ai
# Graceful cutoff before the platform kills the function (ms).
# SOFT runs from first upstream bytes; ABSOLUTE is the final failsafe.
# Both must stay below functions.maxDuration. Defaults 50000 / 55000.
# SOFT_DEADLINE_MS=50000
# ABSOLUTE_DEADLINE_MS=55000
# Proxy fallback (opt-in, dormant unless enabled). Pool is maintained by
# GitHub Actions (scripts/validate-pool.js) on the `pool` branch.
# PROXY_FALLBACK=1
# PROXY_POOL_URL=https://cdn.jsdelivr.net/gh/MarkDev11/oc-proxy@pool/pool.json
# PROXY_TIMEOUT_MS=25000
